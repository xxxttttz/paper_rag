# 默认使用通义千问（阿里云百炼，OpenAI兼容模式）。
# 去 https://bailian.console.aliyun.com/ 开通后，把下面替换成你的DashScope API Key
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 以下变量已在代码里设好通义千问的默认值，不填就行；仅在想换回OpenAI官方或其他服务商时才需要覆盖：
# OPENAI_BASE_URL=            # 留空表示走OpenAI官方
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIM=1536
# CHAT_MODEL=gpt-4o-mini

# 多模态图片索引与视觉问答（默认复用 OPENAI_API_KEY）
# DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# DASHSCOPE_BASE_URL=       # Workspace 专属 DashScope API 地址（可选，不是 compatible-mode 地址）
# VISION_MODEL=qwen3-vl-flash
# IMAGE_EMBEDDING_MODEL=qwen3-vl-embedding
# IMAGE_EMBEDDING_DIM=1024
# IMAGE_TOP_K=2
# IMAGE_PAGE_RENDER_DPI=144
# RENDER_PAGE_IMAGE_FALLBACK=true

# 文本检索精排
# ENABLE_RERANK=true
# RERANK_MODEL=qwen3-rerank
# RERANK_CANDIDATE_K=20

# 企业版基础设施（Docker Compose 本地开发默认值）
# 正式环境必须替换数据库和 MinIO 密码。
# POSTGRES_DB=paper_rag
# POSTGRES_USER=paper_rag
# POSTGRES_PASSWORD=paper_rag_dev
# POSTGRES_PORT=5432
# DATABASE_URL=postgresql://paper_rag:paper_rag_dev@127.0.0.1:5432/paper_rag
# REDIS_PORT=6379
# MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=minioadmin
# MINIO_API_PORT=9000
# MINIO_CONSOLE_PORT=9001
# MILVUS_PORT=19530
# MILVUS_WEB_PORT=9091

# 应用连接服务版 Milvus；不设置时继续使用 data/paper_rag.db（Milvus Lite）
# MILVUS_URI=http://127.0.0.1:19530
# MILVUS_DATABASE=default
# MILVUS_TOKEN=              # 开启 Milvus 鉴权后填写
